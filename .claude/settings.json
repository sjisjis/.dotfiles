{
  "permissions": {
    "allow": [
      "Read(//Users/takumishoji/.terraform.d/**)",
      "Bash(grep -E \"^github_[a-z_]+$\")",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform init *)",
      "Bash(terraform providers schema *)",
      "Bash(gh pr *)",
      "mcp__claude_ai_Notion__notion-fetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env*.local)",
      "Edit(.env)",
      "Edit(.env*.local)",
      "Read(**/config/master.key)",
      "Edit(**/config/master.key)",
      "Read(**/config/credentials.yml.enc)",
      "Edit(**/config/credentials.yml.enc)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null; osascript -e 'display notification \"応答が完了しました\" with title \"Claude Code\"' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Sosumi.aiff 2>/dev/null; osascript -e 'display notification \"操作の許可を確認しています\" with title \"Claude Code\"' 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "考え中",
      "作業中",
      "調査中",
      "確認中",
      "検討中",
      "実装中",
      "分析中",
      "整理中",
      "処理中",
      "構築中",
      "検証中",
      "準備中"
    ]
  },
  "theme": "dark"
}
